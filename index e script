<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <title>Lista de Tarefas</title>
    <style>
        li {
            cursor: pointer;
            padding: 8px;
            background-color: #f0f0f0;
            margin: 5px 0;
            border-radius: 5px;
        }

        li:hover {
            background-color: #dcdcdc;
        }
    </style>
</head>
<body>

    <h1>Lista de Tarefas</h1>


    <input type="text" id="novaTarefa" placeholder="Digite uma tarefa">
    <button onclick="adicionarTarefa()">Adicionar</button>
    <button onclick="limparTudo()">Limpar Tudo</button>

   
    <br><br>
    <input type="text" id="campoPesquisar" placeholder="Pesquisar tarefas" oninput="carregarTarefas()">

    <ul id="listaTarefas"></ul>

     <script src="script.js"></script>



document.addEventListener("DOMContentLoaded", () => {
    carregarTarefas();

    const inputNovaTarefa = document.getElementById("novaTarefa");
    inputNovaTarefa.addEventListener("keydown", function(event) {
        if (event.key === "Enter") {
            adicionarTarefa();
        }
    });
});


        function adicionarTarefa() {
            const input = document.getElementById("novaTarefa");
            const textoTarefa = input.value.trim();

            if (textoTarefa === "") return;

            let tarefas = obterTarefas();
            tarefas.push(textoTarefa);
            salvarTarefas(tarefas);

            input.value = "";
            carregarTarefas();
        }

        function carregarTarefas() {
            const lista = document.getElementById("listaTarefas");
            lista.innerHTML = "";

            const tarefas = obterTarefas();

            
            const filtro = document.getElementById("campoPesquisar").value.toLowerCase();

            tarefas.forEach((tarefa, index) => {
                
                if (tarefa.toLowerCase().includes(filtro)) {
                    const li = document.createElement("li");
                    li.textContent = tarefa;
                    li.onclick = () => removerTarefa(index);
                    lista.appendChild(li);
                }
            });
        }

        function removerTarefa(index) {
            let tarefas = obterTarefas();
            tarefas.splice(index, 1);
            salvarTarefas(tarefas);
            carregarTarefas();
        }

        function limparTudo() {
            salvarTarefas([]);
            carregarTarefas();
        }

        function obterTarefas() {
            return JSON.parse(localStorage.getItem("tarefas")) || [];
        }

        function salvarTarefas(tarefas) {
            localStorage.setItem("tarefas", JSON.stringify(tarefas));
        }
